# تنظیمات نصب بسته‌ها برای محیط build.
#
# این پروژه روی لینوکس حدود ۱۵۰ مگابایت باینری بومی نصب می‌کند:
# @next/swc (کامپایلر Next)، sharp، tailwind oxide و lightningcss.
# این برای هر پروژه Next عادی است، ولی روی میرور کند حساس می‌شود.
#
# تنظیمات زیر عمداً میانه‌رو هستند:
#   - همزمانی دست‌نخورده مانده. کم کردنش دانلود ۱۵۰ مگابایتی را کندتر
#     می‌کند، نه پایدارتر.
#   - timeout کوتاه است تا درخواست گیرکرده سریع شکست بخورد و دوباره
#     تلاش شود، نه اینکه دقیقه‌ها منتظر بماند و شبیه هنگ به نظر برسد.
#   - audit و fund در build فقط رفت‌وبرگشت اضافه‌اند.

fetch-timeout=90000
fetch-retries=4
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

audit=false
fund=false
progress=false
