# تنظیمات نصب بسته‌ها برای محیط build.
#
# عمداً به پیش‌فرض npm نزدیک نگه داشته شده. دو بار تنظیمات شبکه را
# دستکاری کردیم و خطای build عوض نشد، چون خطای «Exit handler never
# called!» به کندی رجیستری ربطی ندارد — یعنی پروسه‌ی npm مرده، نه اینکه
# منتظر جواب مانده باشد. پس اینجا فقط چیزهایی می‌ماند که در build
# بی‌ضرر و مفیدند.

# چند تلاش مجدد برای درخواست شکست‌خورده، با مقادیر متعارف
fetch-retries=3

# در build فقط رفت‌وبرگشت و نویز اضافه‌اند
audit=false
fund=false
progress=false
