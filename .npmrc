# تنظیمات نصب بسته‌ها — مخصوصاً برای محیط build لیارا.
#
# خطای «Exit handler never called!» یک باگ شناخته‌شده npm است که وقتی
# رجیستری کند یا ناپایدار جواب می‌دهد و تعداد اتصال هم‌زمان زیاد است
# خودش را نشان می‌دهد. لیارا از میرور داخلی استفاده می‌کند، پس کم‌کردن
# همزمانی و بالا بردن صبر شبکه مستقیماً همین حالت را هدف می‌گیرد.

# تعداد اتصال هم‌زمان به رجیستری (پیش‌فرض ۱۵)
maxsockets=5

# اگر درخواستی شکست خورد، بیشتر تلاش کن و زودتر تسلیم نشو
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# این دو در build هیچ کاری نمی‌کنند جز کند کردنش
audit=false
fund=false
