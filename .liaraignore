# فایل‌هایی که نباید به سرور build لیارا فرستاده شوند.
#
# هرچه context کوچک‌تر باشد، هم آپلود سریع‌تر است هم احتمال خطای
# حافظه در build کمتر.

# وابستگی‌ها و خروجی build — روی سرور دوباره ساخته می‌شوند
node_modules
.next
out
dist

# سایت قدیمی: فقط برای مرجع نگه داشته شده، در build شرکت نمی‌کند.
# مهم‌تر اینکه package.json و package-lock جداگانه دارد و یک مگابایت
# تصویر بلااستفاده، که هر دو فقط build را سنگین می‌کنند.
_legacy

# ابزارهای محلی
.mimocode
.claude
.git
.vscode
.idea

# متغیرهای محیطی — روی لیارا از پنل خودش خوانده می‌شوند
.env
.env.local
.env.*.local

# متفرقه
*.log
.DS_Store
Thumbs.db
coverage
