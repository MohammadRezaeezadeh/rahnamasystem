# ---------------------------------------------
# نمونه‌ی متغیرهای محیطی - این فایل در گیت هست
# برای اجرای محلی: cp .env.example .env.local
# ---------------------------------------------

# آدرس عمومی سایت (بدون اسلش پایانی)
# در dev: http://localhost:3000
# در production: آدرس دامنه یا آدرس موقت لیارا
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production: https://rahnamasystemco.ir

# اجازه‌ی ایندکس شدن توسط گوگل. فقط روی production مقدار true باشد
# اگر true نباشد، robots.txt کل سایت را از ایندکس خارج می‌کند
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------
# فاز ۱ - دیتابیس
# ---------------------------------------------
# پستگرس محلی (داکر):
DATABASE_URL=postgresql://rahnama:rahnama@localhost:5433/rahnama
# پستگرس لیارا: رشته اتصال از پنل لیارا
# DATABASE_URL=postgresql://root:PASSWORD@HOST:PORT/DBNAME

# off = بدون SSL (پستگرس محلی)
# relax = رمزگذاری بله، بررسی گواهی نه (حالت معمول لیارا)
# strict = بررسی کامل گواهی
DATABASE_SSL=off

# ---------------------------------------------
# فاز ۱ - ورود به پنل مدیریت
# ---------------------------------------------
# با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------------------------------------------
# فاز ۱ - درگاه‌های پرداخت
# ---------------------------------------------
# زرین‌پال - بعد از دریافت اینماد و تأیید پذیرندگی
ZARINPAL_MERCHANT_ID=
# برای تست بدون پول واقعی روی true بگذارید
ZARINPAL_SANDBOX=false

# اسنپ‌پی - بعد از امضای قرارداد پذیرندگی
# تا وقتی هر سه مقدار پر نشوند، گزینه قسطی در صفحه تسویه نمایش داده نمی‌شود
SNAPPAY_API_URL=
SNAPPAY_MERCHANT_CODE=
SNAPPAY_API_KEY=

# --- فازهای بعد ---

# فاز ۲ - ارسال ایمیل سرنخ‌ها
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# LEADS_NOTIFY_EMAIL=

# فاز ۵ - گوگل تگ منیجر
# NEXT_PUBLIC_GTM_ID=
