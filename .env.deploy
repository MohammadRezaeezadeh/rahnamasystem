# مقادیر production که موقع `npm run build:deploy` داخل خروجی پخته می‌شوند.
#
# ⚠ فقط مقادیر عمومی. این فایل در گیت است.
#   رازها (DATABASE_URL، AUTH_SECRET، کلیدهای زرین‌پال و اسنپ‌پی) هرگز
#   اینجا نمی‌آیند — آن‌ها را لیارا موقع اجرا از پنل خودش می‌دهد.
#
# چرا لازم است: فقط NEXT_PUBLIC_* موقع build داخل خروجی می‌نشینند. تا
# وقتی لیارا خودش build می‌کرد این مقادیر از پنل خوانده می‌شد؛ حالا که
# build محلی است، بدون این فایل مقادیر .env.local (یعنی localhost) در
# sitemap و canonical سایت زنده می‌نشست.

# آدرس موقت لیارا. وقتی دامنه وصل شد این خط را به
# https://rahnamasystemco.ir عوض کن و دوباره build:deploy بزن.
NEXT_PUBLIC_SITE_URL=https://rahnama-system.liara.run

# تا نهایی‌شدن اینماد و درگاه‌های پرداخت بسته می‌ماند؛
# robots.txt کل سایت را از ایندکس خارج می‌کند.
NEXT_PUBLIC_ALLOW_INDEXING=false
